rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if true;

      match /friends/{friendId} {
        allow read, write: if true;
      }

      match /friend_requests/{reqId} {
        allow read, write: if true;
      }

      match /recent_chats/{chatId} {
        allow read, write: if true;
      }

      match /user_messages/{msgId} {
        allow read, write: if true;
      }

      match /transactions/{txId} {
        allow read, write: if true;
      }

      match /settings/{settingId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Mandatory Real-time Presence & Global Online Users
    match /presence/{uid} {
      allow read, write: if true;
    }

    match /online_users/{userId} {
      allow read, write: if true;
    }

    // 24-hour Stories
    match /stories/{storyId} {
      allow read, write: if true;
    }

    // Daily Automated & Manual System Backups
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Remote Version Config
    match /config/{docId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if !request.resource.data.keys().hasAny(['isLocked'])
        || request.resource.data.isLocked is bool;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /presence/{presenceId} {
        allow read, write: if true;
      }
    }

    // Direct Messages security: Read and write conversations and their messages
    match /direct_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Canonical Private Chats collection: privateChats/{chatId}/messages/{messageId}
    match /privateChats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /payment_requests/{orderId} {
      allow read, write: if true;
    }

    match /vip_requests/{orderId} {
      allow read, write: if true;
    }

    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    match /friends/{friendshipId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /coin_transfers/{transferId} {
      allow read, write: if true;
    }

    match /stats/{statId} {
      allow read, write: if true;
    }

    match /forum_posts/{postId} {
      allow read, write: if true;

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    match /room_daily_missions/{missionId} {
      allow read, write: if true;
    }

    match /user_reports/{reportId} {
      allow read, write: if true;
    }

    match /app_config/{docId} {
      allow read, write: if true;
    }

    match /tic_tac_toe_matches/{matchId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}

