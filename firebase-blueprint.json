{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "country": { "type": "string", "maxLength": 100 },
        "countryFlag": { "type": "string", "maxLength": 10 },
        "role": { "type": "string", "maxLength": 30 },
        "vipBadge": { "type": "string", "maxLength": 50 },
        "coins": { "type": "number" },
        "earningsEgp": { "type": "number" },
        "earningsUsd": { "type": "number" },
        "badges": { "type": "array" },
        "ratingPoints": { "type": "number" },
        "isBanned": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "frameStyle": { "type": "string", "maxLength": 50 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "isPhoneVerified": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Friend": {
      "title": "Friend",
      "description": "Accepted friendship connection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "friendId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 },
        "countryFlag": { "type": "string", "maxLength": 10 },
        "role": { "type": "string", "maxLength": 50 },
        "vipBadge": { "type": "string", "maxLength": 50 },
        "bio": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 20 },
        "addedAt": { "type": "number" }
      },
      "required": ["friendId", "name"]
    },
    "Message": {
      "title": "Message",
      "description": "Message sent in a chat room",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "userVipTier": { "type": "string", "maxLength": 50 },
        "userVipBadge": { "type": "string", "maxLength": 50 },
        "badges": { "type": "array" },
        "type": { "type": "string", "maxLength": 30 },
        "mediaUrl": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "maxLength": 20 },
        "stickerEmoji": { "type": "string", "maxLength": 40 },
        "stickerLabel": { "type": "string", "maxLength": 80 },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["text", "userId", "userName"]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "One-on-one direct chat conversation metadata",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 260 },
        "participants": { "type": "array" },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "string", "maxLength": 2000 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastSenderName": { "type": "string", "maxLength": 100 },
        "lastTimestamp": { "type": "number" },
        "typing": { "type": "object" }
      },
      "required": ["chatId", "participants"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Direct message sent between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 500 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 2000 },
        "text": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "maxLength": 30 },
        "mediaUrl": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "maxLength": 20 },
        "stickerEmoji": { "type": "string", "maxLength": 40 },
        "stickerLabel": { "type": "string", "maxLength": 80 },
        "expiresAt": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "timestamp": { "type": "number" }
      },
      "required": ["senderId", "recipientId"]
    },
    "VisitorStat": {
      "title": "VisitorStat",
      "description": "Global cumulative platform visitor counter",
      "type": "object",
      "properties": {
        "totalVisitors": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["totalVisitors"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Social dating & community forum post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "authorGender": { "type": "string", "maxLength": 20 },
        "authorCountryFlag": { "type": "string", "maxLength": 10 },
        "authorVipBadge": { "type": "string", "maxLength": 50 },
        "authorRole": { "type": "string", "maxLength": 30 },
        "text": { "type": "string", "maxLength": 2000 },
        "likedBy": { "type": "array" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "viewedBy": { "type": "array" },
        "viewers": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "authorId", "authorName", "text"]
    },
    "ForumComment": {
      "title": "ForumComment",
      "description": "Comment on a forum post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "postId", "authorId", "text"]
    },
    "SharedRoomMission": {
      "title": "SharedRoomMission",
      "description": "Daily shared collaborative room mission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "dateKey": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 400 },
        "icon": { "type": "string", "maxLength": 20 },
        "currentProgress": { "type": "number" },
        "targetProgress": { "type": "number" },
        "rewardCoins": { "type": "number" },
        "rewardVipLabel": { "type": "string", "maxLength": 100 },
        "contributors": { "type": "array" },
        "claimedBy": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "targetProgress"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Abuse report submitted against a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 100 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reportedUserName": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 150 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 30 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "reporterId", "reportedUserId", "reason"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Pending payment and manual recharge order for review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 30 },
        "itemName": { "type": "string", "maxLength": 100 },
        "amountEgp": { "type": "number" },
        "coinsAmount": { "type": "number" },
        "vipTierId": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "senderAccountOrPhone": { "type": "string", "maxLength": 100 },
        "transactionRef": { "type": "string", "maxLength": 150 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "amountEgp", "status"]
    },
    "RoomSettings": {
      "title": "RoomSettings",
      "description": "Shared room settings including lock status",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "maxLength": 128 },
        "isLocked": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "number" }
      },
      "required": ["isLocked"]
    },
    "CoinTransfer": {
      "title": "CoinTransfer",
      "description": "Peer-to-peer coin transfer record",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["senderId", "recipientId", "amount"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application version and push-update announcement config",
      "type": "object",
      "properties": {
        "version": { "type": "string", "maxLength": 50 },
        "message": { "type": "string", "maxLength": 500 },
        "pushedBy": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "number" }
      },
      "required": ["version", "timestamp"]
    },
    "TicTacToeMatch": {
      "title": "TicTacToeMatch",
      "description": "Live multiplayer Tic-Tac-Toe match with coin wager",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "playerXId": { "type": "string", "maxLength": 128 },
        "playerOId": { "type": "string", "maxLength": 128 },
        "wagerCoins": { "type": "number" },
        "winnerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "status"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Mandatory real-time presence document updated with 30s heartbeat and 60s timeout",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "online": { "type": "boolean" },
        "lastSeen": { "type": "number" },
        "currentRoom": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 }
      },
      "required": ["online", "lastSeen"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour user status story with image or text",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "mediaUrl": { "type": "string", "maxLength": 2000 },
        "caption": { "type": "string", "maxLength": 300 },
        "likedBy": { "type": "array" },
        "likesCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "viewers": { "type": "object" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "userId", "createdAt", "expiresAt"]
    },
    "UserThemeSettings": {
      "title": "UserThemeSettings",
      "description": "Persisted user theme, dark mode, and wallpaper settings",
      "type": "object",
      "properties": {
        "darkMode": { "type": "boolean" },
        "chatThemeId": { "type": "string", "maxLength": 100 },
        "wallpaperUrl": { "type": "string", "maxLength": 2000 },
        "muteJoinNotifications": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      }
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Daily automated or manual platform backup snapshot metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "usersCount": { "type": "number" },
        "roomsCount": { "type": "number" },
        "type": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "createdAt"]
    },
    "RemoteConfig": {
      "title": "RemoteConfig",
      "description": "Remote app version and forced-update check document",
      "type": "object",
      "properties": {
        "app_version": { "type": "string", "maxLength": 50 },
        "force_update": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "number" }
      },
      "required": ["app_version"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Pending friend request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 500 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "number" }
      },
      "required": ["senderId", "receiverId", "status"]
    },
    "RecentChatIndex": {
      "title": "RecentChatIndex",
      "description": "Per-user summary of direct conversations and unread counters",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 260 },
        "peerId": { "type": "string", "maxLength": 128 },
        "peerName": { "type": "string", "maxLength": 100 },
        "peerAvatar": { "type": "string", "maxLength": 500 },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastTimestamp": { "type": "number" },
        "unreadCount": { "type": "number" }
      },
      "required": ["chatId", "peerId"]
    },
    "CallSignal": {
      "title": "CallSignal",
      "description": "WebRTC audio/video call signaling payload",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "callerId": { "type": "string", "maxLength": 128 },
        "calleeId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 30 },
        "callType": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "number" }
      },
      "required": ["callerId", "calleeId", "type"]
    },
    "RoomPresence": {
      "title": "RoomPresence",
      "description": "Live user occupancy document inside a specific room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "isOnline": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 20 },
        "lastSeen": { "type": "number" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": "Friend",
      "description": "Accepted friends list of a user"
    },
    "/users/{userId}/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Incoming friend requests for a user"
    },
    "/users/{userId}/recent_chats/{chatId}": {
      "schema": "RecentChatIndex",
      "description": "Per-user private chat inbox index and unread counters"
    },
    "/users/{userId}/user_messages/{msgId}": {
      "schema": "DirectMessage",
      "description": "Per-user message mirror for fast private inbox synchronization"
    },
    "/users/{userId}/call_signals/{signalId}": {
      "schema": "CallSignal",
      "description": "Incoming audio/video WebRTC call signaling queue"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": "PaymentRequest",
      "description": "Per-user coin and VIP recharge history"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserThemeSettings",
      "description": "Per-user persisted theme, dark mode, and wallpaper preferences"
    },
    "/presence/{uid}": {
      "schema": "Presence",
      "description": "Mandatory real-time online presence with heartbeat and current room"
    },
    "/online_users/{userId}": {
      "schema": "User",
      "description": "Live active online users directory with status and lastSeen heartbeat"
    },
    "/friendRequests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Top-level pending friend request records"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "24-hour user status stories"
    },
    "/backups/{backupId}": {
      "schema": "BackupSnapshot",
      "description": "Automated and manual system backup snapshots"
    },
    "/config/{docId}": {
      "schema": "RemoteConfig",
      "description": "Silent remote version check and forced update flags"
    },
    "/rooms/{roomId}": {
      "schema": "RoomSettings",
      "description": "Room lock state, last message summary, and settings controlled by room managers"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Public room message feed (auto-expires after 24h)"
    },
    "/rooms/{roomId}/presence/{presenceId}": {
      "schema": "RoomPresence",
      "description": "Live connected occupants inside each public or private room"
    },
    "/direct_chats/{chatId}": {
      "schema": "DirectChat",
      "description": "Legacy direct message conversations"
    },
    "/direct_chats/{chatId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Legacy direct messages"
    },
    "/privateChats/{chatId}": {
      "schema": "DirectChat",
      "description": "Canonical one-on-one private chat conversation metadata"
    },
    "/privateChats/{chatId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Canonical private chat messages with tempId, serverTimestamp, and read/seen states"
    },
    "/stats/{statId}": {
      "schema": "VisitorStat",
      "description": "Global platform cumulative visitor statistics"
    },
    "/forum_posts/{postId}": {
      "schema": "ForumPost",
      "description": "Community social forum posts"
    },
    "/forum_posts/{postId}/comments/{commentId}": {
      "schema": "ForumComment",
      "description": "Comments under forum posts"
    },
    "/room_daily_missions/{missionId}": {
      "schema": "SharedRoomMission",
      "description": "Daily collaborative room missions"
    },
    "/user_reports/{reportId}": {
      "schema": "UserReport",
      "description": "User abuse reports sent to admin panel"
    },
    "/payment_requests/{orderId}": {
      "schema": "PaymentRequest",
      "description": "Pending payment verification orders"
    },
    "/coin_transfers/{transferId}": {
      "schema": "CoinTransfer",
      "description": "Peer-to-peer coin transfer ledger"
    },
    "/app_config/{docId}": {
      "schema": "AppConfig",
      "description": "App version and live update notice banner state"
    },
    "/tic_tac_toe_matches/{matchId}": {
      "schema": "TicTacToeMatch",
      "description": "Live multiplayer Tic-Tac-Toe game results and wagers"
    }
  }
}
